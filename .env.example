# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Public origin Twilio/Vapi use to reach this service (no trailing slash).
# Required for Twilio signature validation in production.
WEBHOOK_BASE_URL=https://your-domain.example

# Webhook authentication (recommended true in production)
VALIDATE_TWILIO_SIGNATURE=true
VALIDATE_VAPI_SIGNATURE=true

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# Vapi
VAPI_API_KEY=your_vapi_private_key
VAPI_API_BASE_URL=https://api.vapi.ai
VAPI_ASSISTANT_ID=asst_xxxxxxxx
VAPI_PHONE_NUMBER_ID=pn_xxxxxxxx
# Shared secret sent as Authorization: Bearer <token> and/or X-Vapi-Secret
VAPI_WEBHOOK_SECRET=replace_with_long_random_secret

# GoHighLevel API v2 (LeadConnector)
GHL_API_KEY=your_ghl_private_integration_token
GHL_LOCATION_ID=your_location_id
GHL_CALENDAR_ID=your_calendar_id
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_TIMEZONE=America/New_York
GHL_APPOINTMENT_DURATION_MINUTES=30
GHL_CONTACT_SOURCE=Voice Receptionist
GHL_CONTACT_TAGS=voice-ai,inbound-call
GHL_CONTACTS_API_VERSION=2021-07-28
GHL_CALENDARS_API_VERSION=2021-04-15

# Optional: human transfer destination used by the transfer_to_human tool
TRANSFER_PHONE_NUMBER=

# Timeouts (ms)
GHL_TIMEOUT_MS=4000
VAPI_TIMEOUT_MS=5000

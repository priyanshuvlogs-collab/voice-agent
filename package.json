{
  "name": "voice-agent",
  "version": "1.0.0",
  "description": "Low-latency AI Voice Receptionist: Twilio inbound calls, Vapi conversation, GoHighLevel booking tools.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "twilio",
    "vapi",
    "gohighlevel",
    "voice",
    "receptionist"
  ],
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "libphonenumber-js": "^1.12.15",
    "luxon": "^3.7.2",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "twilio": "^5.8.2",
    "undici": "^7.15.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.23",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
